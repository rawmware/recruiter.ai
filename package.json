{
  "name": "recruiter-ai",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env.local server/index.mjs",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env.local server/index.mjs --production",
    "test": "node --test tests/*.test.mjs",
    "verify": "node scripts/verify.mjs",
    "data": "node pipeline/run.mjs",
    "buildlog": "node scripts/buildlog.mjs",
    "serve": "node scripts/serve.mjs",
    "test:pipeline": "node --test tests/gradient-ring.test.mjs tests/gradient-ring-parallel.test.mjs tests/html.test.mjs tests/classify.test.mjs tests/sources.test.mjs tests/signals.test.mjs tests/aggregate.test.mjs tests/trends.test.mjs tests/taxonomy.test.mjs tests/buildlog.test.mjs"
  },
  "dependencies": {
    "@openai/agents": "^0.18.0",
    "cheerio": "^1.1.2",
    "express": "^5.1.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "libsodium-wrappers": "^0.8.4",
    "playwright": "^1.58.0",
    "vite": "^7.0.0"
  }
}
